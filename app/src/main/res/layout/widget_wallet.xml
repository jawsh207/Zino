<?xml version="1.0" encoding="utf-8"?>
<!-- The wallet widget: the last balance Zino saw, when it saw it, and a button to hide it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_wallet" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/wallet"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
        <ImageView
            android:id="@+id/wallet_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/widget_hide_balance"
            android:padding="8dp"
            android:src="@drawable/ic_widget_eye" />
    </LinearLayout>
    <TextView
        android:id="@+id/wallet_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_on"
        android:textSize="22sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/wallet_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
